TELEGRAM_SECRET=123456:replace-with-telegram-bot-token
TELEGRAM_BOT_TOKEN=123456:replace-with-telegram-bot-token

# Local development defaults used by docker-compose.yml.
POSTGRES_PASSWORD=postgres
MINIO_ROOT_USER=ROOTUSER
MINIO_ROOT_PASSWORD=PASSWORD

# Notification/payment reminder topics.
KAFKA_BROKERS=kafka:9092
KAFKA_TOPICS=lesson-reminders,assignment-reminders,payment-reminders
PAYMENT_REMINDER_TOPIC=payment-reminders

# Public URL exposed by nginx/reverse proxy.
GATEWAY_PUBLIC_URL=http://localhost:80
