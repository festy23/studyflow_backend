# === Telegram ===
# Bot token from @BotFather (format: 123456:ABC-DEF).
# Used for initData validation and notification service.
TELEGRAM_SECRET=123456:replace-with-telegram-bot-token
TELEGRAM_BOT_TOKEN=123456:replace-with-telegram-bot-token

# === Auth ===
# Set to "true" to disable legacy HMAC auth (telegram <tgId>:<ts>:<hmac>).
# When disabled, only initData auth (tma <initData>) is accepted.
# AUTH_DISABLE_LEGACY_HMAC=false

# === Databases & Storage ===
POSTGRES_PASSWORD=postgres
MINIO_ROOT_USER=ROOTUSER
MINIO_ROOT_PASSWORD=PASSWORD

# === Kafka ===
KAFKA_BROKERS=kafka:9092
KAFKA_TOPICS=lesson-reminders,assignment-reminders,payment-reminders
PAYMENT_REMINDER_TOPIC=payment-reminders

# === Public URL ===
# Base URL used to generate file download links.
# Local:  http://localhost:80
# ngrok:  run ./scripts/configure-ngrok.sh to auto-set
GATEWAY_PUBLIC_URL=http://localhost:80
